{
  "name": "pocket-professor-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run build:phase3",
    "start:prod": "node scripts/run_adaptation_fastify.mjs",
    "build:phase3": "tsc -p tsconfig.json",
    "test:phase3": "npm run build:phase3 && node --test dist/tests/adaptation/policyEngine.test.js dist/tests/adaptation/adaptationEvaluationPersistence.test.js dist/tests/adaptation/adaptationEvaluationService.test.js dist/tests/adaptation/adaptationEvaluationFileAdapter.test.js dist/tests/adaptation/adaptationEvaluationPostgresAdapter.test.js dist/tests/adaptation/adaptationEvaluationEntrypoints.test.js dist/tests/adaptation/adaptationFrameworkBindings.test.js dist/tests/adaptation/adaptationObservability.test.js dist/tests/adaptation/adaptationWorkerRetryPolicy.test.js dist/tests/adaptation/adaptationBrokerWorker.test.js dist/tests/agents/agentOutputGuard.test.js dist/tests/agents/ai/aiProviderService.test.js dist/tests/agents/ai/agentInferenceRunner.test.js dist/tests/agents/ai/agentSpecConsistency.test.js",
    "start:adaptation-runtime": "npm run build:phase3 && node --env-file=../.env scripts/run_adaptation_fastify.mjs",
    "smoke:adaptation-runtime": "bash scripts/smoke_adaptation_runtime.sh",
    "start:adaptation-worker": "npm run build:phase3 && node --env-file=../.env scripts/run_adaptation_worker.mjs",
    "smoke:adaptation-worker": "npm run build:phase3 && bash scripts/smoke_adaptation_worker.sh",
    "start:adaptation-broker-worker": "npm run build:phase3 && node --env-file=../.env scripts/run_adaptation_broker_worker.mjs",
    "smoke:adaptation-broker-worker": "npm run build:phase3 && bash scripts/smoke_adaptation_broker_worker.sh",
    "smoke:ai": "npm run build:phase3 && node --env-file=../.env scripts/smoke_ai_provider.mjs",
    "smoke:agents": "npm run build:phase3 && node --env-file=../.env scripts/smoke_agent_inference.mjs",
    "db:migrate:adaptation:up": "psql \"$ADAPTATION_DATABASE_URL\" -v ON_ERROR_STOP=1 -f db/migrations/20260325_001_create_adaptation_evaluations.up.sql",
    "db:migrate:adaptation:down": "psql \"$ADAPTATION_DATABASE_URL\" -v ON_ERROR_STOP=1 -f db/migrations/20260325_001_create_adaptation_evaluations.down.sql",
    "db:migrate:pilot:up": "psql \"$ADAPTATION_DATABASE_URL\" -v ON_ERROR_STOP=1 -f db/migrations/20260411_002_create_pilot_tables.up.sql",
    "db:migrate:pilot:down": "psql \"$ADAPTATION_DATABASE_URL\" -v ON_ERROR_STOP=1 -f db/migrations/20260411_002_create_pilot_tables.down.sql",
    "db:migrate:sprint:up": "psql \"$ADAPTATION_DATABASE_URL\" -v ON_ERROR_STOP=1 -f db/migrations/20260413_003_create_sprint_tables.up.sql",
    "db:migrate:sprint:down": "psql \"$ADAPTATION_DATABASE_URL\" -v ON_ERROR_STOP=1 -f db/migrations/20260413_003_create_sprint_tables.down.sql",
    "db:migrate:logincodes:up": "psql \"$ADAPTATION_DATABASE_URL\" -v ON_ERROR_STOP=1 -f db/migrations/20260614_004_login_code_attempts.up.sql",
    "db:migrate:logincodes:down": "psql \"$ADAPTATION_DATABASE_URL\" -v ON_ERROR_STOP=1 -f db/migrations/20260614_004_login_code_attempts.down.sql"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "fastify": "^5.7.3",
    "pg": "^8.16.3"
  }
}