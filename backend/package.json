{
  "name": "pocket-professor-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:phase3": "tsc -p tsconfig.json",
    "test:phase3": "npm run build:phase3 && node --test dist/tests/adaptation/policyEngine.test.js dist/tests/adaptation/adaptationEvaluationPersistence.test.js dist/tests/adaptation/adaptationEvaluationService.test.js dist/tests/adaptation/adaptationEvaluationFileAdapter.test.js dist/tests/adaptation/adaptationEvaluationEntrypoints.test.js dist/tests/adaptation/adaptationFrameworkBindings.test.js dist/tests/agents/agentOutputGuard.test.js",
    "start:adaptation-runtime": "npm run build:phase3 && node scripts/run_adaptation_fastify.mjs",
    "smoke:adaptation-runtime": "bash scripts/smoke_adaptation_runtime.sh"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "fastify": "^4.28.1"
  }
}
