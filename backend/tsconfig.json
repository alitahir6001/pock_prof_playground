{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "rootDir": ".",
    "outDir": "dist"
  },
  "include": [
    "src/modules/adaptation/phase3/**/*.ts",
    "src/modules/agents/phase2/validation/**/*.ts",
    "src/modules/agents/phase2/ai/**/*.ts",
    "tests/agents/ai/**/*.ts",
    "tests/adaptation/**/*.ts",
    "tests/agents/**/*.ts"
  ]
}
